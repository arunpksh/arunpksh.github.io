@article{Prakash2015b,
 abstract = {The accumulative roll bonding process is one of the most prominent severe plastic deformation processes for obtaining sheet materials with ultra-fine-grained microstructures and high strength. The properties of such sheets differ significantly from those of conventionally rolled sheets. It is hence desirable to have a simulation framework that can accurately predict the material properties, including the evolving texture and anisotropy during processing. Here, we propose such a framework for multiple pass rolling using explicit finite elements and embedding the visco-plastic self-consistent (VPSC) polycrystal texture model for the material response. To facilitate multiple pass rolling, we propose a novel solution mapping scheme that transfers the material state from the deformed finite element mesh to a new one. Additionally, we implement a two-level parallelization scheme - with decomposition of the FE domain using message passing interface (MPI) and thread based parallelization of the material response using openMP - to ensure reduced simulation times. The predictive capabilities of the proposed framework are demonstrated by simulating the accumulative roll bonding of aluminum alloy AA5754 sheets. The simulations validate the working of the solution mapping scheme, and clearly show the development of a through thickness gradient of texture and anisotropy in the roll-bonded sheet after two passes.},
 author = {A. Prakash and W.G. Nöhring and R.A. Lebensohn and H.W. Höppel and E. Bitzek},
 doi = {10.1016/j.msea.2015.02.005},
 issn = {09215093},
 journal = {Materials Science and Engineering A},
 keywords = {Accumulative roll bonding (ARB),Finite element (FE) multi-level parallelization,Multiple pass rolling,Solution variables mapping,Ultra-fine-grained (UFG) aluminum,Visco plastic self-consistent (VPSC)},
 pages = {104-119},
 title = {A multiscale simulation framework of the accumulative roll bonding process accounting for texture evolution},
 volume = {631},
 year = {2015}
}
